{
  "manifest_version": 3,
  "name": "Job Tailor",
  "version": "1.3.0",
  "key": "",
  "description": "Review a job posting, tailor your resume and cover letter, answer application questions, and track what you applied to.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "scripting",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Job Tailor",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+J"
      },
      "description": "Open Job Tailor"
    }
  }
}
